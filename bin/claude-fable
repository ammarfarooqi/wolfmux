#!/bin/bash
# claude-fable — Claude Code on the Claude subscription (OAuth /login), pinned to Fable.
# Also installed as claude-opus, claude-sonnet and claude-haiku (symlinks): the same
# launcher, the model chosen by the name it is called by.
#
# Holds no credential and sets no endpoint. It removes every provider, credential
# and model override from ITS OWN process environment, then execs the normal
# `claude` binary, so the only credential left is the subscription login.
# Your shell environment is not modified.
#
#   WOLFMUX_FABLE_MODEL   a pin: always this model id; likewise WOLFMUX_OPUS_MODEL,
#                         WOLFMUX_SONNET_MODEL, WOLFMUX_HAIKU_MODEL
#   WOLFMUX_MODEL_POLICY  latest (default): with no pin, Claude Code's own alias (fable,
#                         opus, sonnet, haiku), which means its newest model of that family;
#                         pinned: the built-in id of lib/models.sh. teamctl passes the id it
#                         resolved and recorded with --model, which outranks both.
#   WOLFMUX_CLAUDE_BIN    explicit path to the claude binary
#   WOLFMUX_DRY_RUN=1     print what would run (no secrets) and exit
#   WOLFMUX_EXTRA_SETTINGS per-agent Claude Code settings file, set by teamctl
set -euo pipefail

LIB="${WOLFMUX_HOME:-$HOME/.config/wolfmux}/lib/provider-env.sh"
if [ ! -r "$LIB" ]; then
  echo "claude-fable: missing $LIB — refusing to launch without environment scrubbing" >&2
  exit 78
fi
# shellcheck source=/dev/null
. "$LIB"
wolfmux_load_config

SCRUBBED="$(wolfmux_list_set_vars "$WOLFMUX_CLAUDE_PROVIDER_VARS" "$WOLFMUX_CLAUDE_PROVIDER_PREFIXES" | tr '\n' ' ')"
wolfmux_scrub_claude_env

CLAUDE_BIN="$(wolfmux_resolve_claude)" || {
  echo "claude-fable: Claude Code CLI not found. Install: https://code.claude.com/docs/en/setup" >&2
  exit 127
}

MODELS_LIB="${WOLFMUX_HOME:-$HOME/.config/wolfmux}/lib/models.sh"
if [ ! -r "$MODELS_LIB" ]; then
  echo "claude-fable: missing $MODELS_LIB — run ./install.sh again" >&2
  exit 78
fi
# shellcheck source=/dev/null
. "$MODELS_LIB"

SELF="$(basename "$0")"
case "$SELF" in
  claude-opus) ALIAS="opus" ;;
  claude-sonnet) ALIAS="sonnet" ;;
  claude-haiku) ALIAS="haiku" ;;
  *) ALIAS="fable" ;;
esac
# A pin wins; policy pinned means the built-in id; otherwise Claude Code's own alias, which
# Claude Code documents as its newest model of that family.
models_pin_var "$ALIAS"
if [ -n "$MODELS_PIN" ]; then
  MODEL="$MODELS_PIN"
elif [ "$(models_policy)" = "pinned" ] && models_builtin "$ALIAS"; then
  MODEL="$MB_ID"
else
  MODEL="$ALIAS"
fi
# The agent's own shell does not inherit them: a teamctl it runs then reads the config file as
# it is now, not a value frozen into the tmux server's environment when the team started (a pin
# deleted from the config would otherwise still pin every spawn that agent makes).
unset WOLFMUX_FABLE_MODEL WOLFMUX_OPUS_MODEL WOLFMUX_SONNET_MODEL WOLFMUX_HAIKU_MODEL WOLFMUX_MODEL_POLICY

if wolfmux_is_claude_subcommand "${1:-}"; then
  exec "$CLAUDE_BIN" "$@"
fi

CMD=("$CLAUDE_BIN")
# Per-agent settings that teamctl generated for this pane (hooks, and what differs by role).
SETTINGS_JSON="$(wolfmux_merge_settings "" "${WOLFMUX_EXTRA_SETTINGS:-}")" || exit 78
if [ "$SETTINGS_JSON" != "{}" ]; then
  CMD+=(--settings "$SETTINGS_JSON")
fi
if ! wolfmux_args_have_model "$@"; then
  CMD+=(--model "$MODEL")
fi
CMD+=("$@")

if [ "${WOLFMUX_DRY_RUN:-}" = "1" ]; then
  echo "launcher:        $SELF"
  echo "billing:         Claude subscription (OAuth login); no key, no custom endpoint"
  echo "scrubbed vars:   ${SCRUBBED:-(none were set)}"
  echo "provider env now: $(wolfmux_list_set_vars "$WOLFMUX_CLAUDE_PROVIDER_VARS" "$WOLFMUX_CLAUDE_PROVIDER_PREFIXES" | tr '\n' ' ')(none expected)"
  printf 'would exec:     '; printf ' %q' "${CMD[@]}"; echo
  exit 0
fi

exec "${CMD[@]}"
