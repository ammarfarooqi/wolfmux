#!/bin/bash
# claude-fable — Claude Code on the Claude subscription (OAuth /login), pinned to Fable.
#
# Holds no credential and sets no endpoint. It removes every provider, credential
# and model override from ITS OWN process environment, then execs the normal
# `claude` binary, so the only credential left is the subscription login.
# Your shell environment is not modified.
#
#   AI_TEAM_FABLE_MODEL   model to pin (default: claude-fable-5-1[1m])
#   AI_TEAM_CLAUDE_BIN    explicit path to the claude binary
#   AI_TEAM_DRY_RUN=1     print what would run (no secrets) and exit
set -euo pipefail

LIB="${AI_TEAM_HOME:-$HOME/.config/ai-team}/lib/provider-env.sh"
if [ ! -r "$LIB" ]; then
  echo "claude-fable: missing $LIB — refusing to launch without environment scrubbing" >&2
  exit 78
fi
# shellcheck source=/dev/null
. "$LIB"
ai_team_load_config

SCRUBBED="$(ai_team_list_set_vars "$AI_TEAM_CLAUDE_PROVIDER_VARS" "$AI_TEAM_CLAUDE_PROVIDER_PREFIXES" | tr '\n' ' ')"
ai_team_scrub_claude_env

CLAUDE_BIN="$(ai_team_resolve_claude)" || {
  echo "claude-fable: Claude Code CLI not found. Install: https://code.claude.com/docs/en/setup" >&2
  exit 127
}

MODEL="${AI_TEAM_FABLE_MODEL:-claude-fable-5-1[1m]}"

if ai_team_is_claude_subcommand "${1:-}" || ai_team_args_have_model "$@"; then
  CMD=("$CLAUDE_BIN" "$@")
else
  CMD=("$CLAUDE_BIN" --model "$MODEL" "$@")
fi

if [ "${AI_TEAM_DRY_RUN:-}" = "1" ]; then
  echo "launcher:        claude-fable"
  echo "billing:         Claude subscription (OAuth login); no key, no custom endpoint"
  echo "scrubbed vars:   ${SCRUBBED:-(none were set)}"
  echo "provider env now: $(ai_team_list_set_vars "$AI_TEAM_CLAUDE_PROVIDER_VARS" "$AI_TEAM_CLAUDE_PROVIDER_PREFIXES" | tr '\n' ' ')(none expected)"
  printf 'would exec:     '; printf ' %q' "${CMD[@]}"; echo
  exit 0
fi

exec "${CMD[@]}"
