#!/bin/bash
# teamctl — tmux processes, models, git worktrees and lifecycle for a local
# multi-model AI development team. Nothing else: tasks and messages live in
# Beads (bd). No daemon, no network service, no API keys.
#
# Code:    ~/.config/wolfmux/lib/*.sh      State: ~/.wolfmux/state/<project>/
# Docs:    ~/.config/wolfmux/README.md     Worktrees: ~/.wolfmux/worktrees/<project>/
set -euo pipefail

# The hot path. An agent's CLI runs `teamctl _hook PostToolUse` after every tool call, so the usual
# case, nothing to say, has to cost one bash start: no module, no fork. It counts the call (the
# file's age is the agent's last sign of life) and ends, unless something is queued for the agent
# (the attention file) or this is the tenth call since the last full look (WOLFMUX_HOOK_EVERY in
# lib/hooks.sh, which this cannot read without loading it).
if [ "${1:-}" = "_hook" ] && [ "${2:-}" = "PostToolUse" ] && [ -n "${WOLFMUX_RUN_DIR:-}" ] && [ -d "$WOLFMUX_RUN_DIR" ]; then
  _calls=0
  if [ -r "$WOLFMUX_RUN_DIR/calls" ]; then IFS= read -r _calls <"$WOLFMUX_RUN_DIR/calls" || true; fi
  case "$_calls" in "" | *[!0-9]*) _calls=0 ;; esac
  [ "${#_calls}" -le 9 ] || _calls=0
  _calls=$((10#$_calls + 1))
  printf '%s\n' "$_calls" >"$WOLFMUX_RUN_DIR/calls" 2>/dev/null || true
  # The offload safety net (lib/offload.sh offload_post), only when the agent's settings switched
  # it on: the CLI's JSON is read with the read builtin, at most WOLFMUX_OFFLOAD_MIN characters, so
  # a short result costs no fork. Only a longer one loads the module. What was read is handed on to
  # the full hook in WOLFMUX_HOOK_STDIN, since stdin cannot be read twice.
  if [ "${WOLFMUX_OFFLOAD_SAFETY:-}" = on ]; then
    _wm_in=""
    if IFS= read -r -d '' -n "${WOLFMUX_OFFLOAD_MIN:-4000}" _wm_in; then
      WOLFMUX_HOME="${WOLFMUX_HOME:-$HOME/.config/wolfmux}"
      # shellcheck source=/dev/null
      . "$WOLFMUX_HOME/lib/offload.sh" 2>/dev/null && offload_post "$_wm_in$(/bin/cat)" || true
      exit 0
    fi
    export WOLFMUX_HOOK_STDIN="$_wm_in"
  fi
  if [ ! -e "$WOLFMUX_RUN_DIR/attention" ] && [ $((_calls % 10)) -ne 0 ]; then exit 0; fi
fi

WOLFMUX_HOME="${WOLFMUX_HOME:-$HOME/.config/wolfmux}"
# The offload rewrite (lib/offload.sh): a PreToolUse hook on every Bash call, so it loads that one
# module and nothing else: one bash start and one jq.
if [ "${1:-}" = "_offload-pre" ]; then
  if [ -r "$WOLFMUX_HOME/lib/offload.sh" ]; then
    # shellcheck source=/dev/null
    . "$WOLFMUX_HOME/lib/offload.sh" && offload_pre_hook || true
  fi
  exit 0
fi
TEAMCTL_SELF="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"

for module in provider-env common registry tmuxctl worktree disk reclaim finish beads policy approvals agents views dashboard restore doctor brand notify inbox layout guard memory completion hooks store mail recall tasks offload; do
  if [ ! -r "$WOLFMUX_HOME/lib/$module.sh" ]; then
    echo "teamctl: missing $WOLFMUX_HOME/lib/$module.sh" >&2
    exit 78
  fi
  # shellcheck source=/dev/null
  . "$WOLFMUX_HOME/lib/$module.sh"
  # ~/.config/wolfmux/config supplies defaults; the environment wins. Read right after the
  # module that defines the reader, and BEFORE the rest: inbox.sh and agents.sh set their
  # defaults when they are sourced (WOLFMUX_NUDGE_TYPE="${WOLFMUX_NUDGE_TYPE:-…}"), and the
  # loader skips a name that is already set, so loading it after them ignored every one of
  # those keys in the file (found 2026-10-15; tests/providers.sh runs this binary to check).
  if [ "$module" = provider-env ]; then wolfmux_load_config; fi
done
TEAMCTL_ARGS="$*"
trap 'teamctl_on_exit' EXIT
tm_adopt_legacy_server

usage() {
  /bin/cat <<'EOF'
teamctl — tmux panes, models, worktrees and lifecycle for your AI team

  Teams  a project can have several: add --team <name> to any command (before or after it).
         With one team you never need it. teamctl status shows them all; teamctl teams is the short list.
    teamctl start fable --team review               a second team, named by you, with its own session
    teamctl start fable --team next --handover <bead-id>    (a lead may do this too) the new lead starts by reading that bead
         A team whose lead is not running is orphaned (teamctl teams says why, and what it holds). Then the lead that founded it
         may recover or clean it up, as you may: teamctl restart lead --team <name> --continue · stop · remove · finish ·
         destroy --team <name> --purge. You are told.
         A team YOU founded: the lead of the team policy orphan-steward names may restart its lead and stop its agents, no more.
    teamctl restore [--dry-run] [--yes] [--no-tabs]   after a reboot: bring back the leads that were running, one at a time,
                                                      then their iTerm2 tabs. Skips deliberate stops. Enter confirms once;
                                                      --yes skips the question, --no-tabs skips tabs. Anyone may --dry-run;
                                                      otherwise the human, or the orphan steward for human-founded teams.
    teamctl finish [--dry-run]                      (the lead, or you) the team is DONE: park every lane, take every lane that
                                                      passes the reclaim gates, and when no lane is left and no task of the team
                                                      is open, take the team too: records, state directory, session. Something
                                                      still holding it: the session ends, the team stays, teamctl teams says why,
                                                      and teamctl reclaim --all-teams finishes it once nothing holds it. Only
                                                      finish ever takes a team: a lead that stopped, crashed or was destroyed
                                                      never counts. Transcripts are never deleted. --dry-run: anyone may look
  Lead  (the only manager of its team; start/stop/restart/model/remove/destroy/policy/approve/deny are reserved for it and for you,
         and start/restart/model/stop/remove/destroy for the founder of a team whose lead is not running)
         Leads run Opus; Fable only when a lead needs more than Opus gives: teamctl model lead fable [--now]
    teamctl start [<model>] [--no-attach] [--continue] [--resume <session-id>] [--ticket <KEY>] [--init-beads|--skip-beads]
                  [--lead-permissions skip|ask] [--worker-permissions skip|lead|ask] [--worker-spawn on|off]
                  no model: a new team's lead runs Opus (policy lead-model); a team that had a lead, that lead's model.
                  Fable only when asked for: teamctl start fable
                  --continue reopens this agent's own conversation (its stored id); --resume names one instead
    teamctl model <role> <model> [--now]          what <role> starts on from its next start, restart or restore.
                                                      --now: switch it at once by a resume-restart (same conversation),
                                                      only when it is between turns and nobody is at its pane; otherwise
                                                      recorded only. A /model typed into a pane is adopted as its record
                                                      too, but writes ~/.claude/settings.json for every new session
                  --ticket: the team's default ticket key, for a branch template that asks for one
  Workers
    teamctl spawn <role> <model> [--base <ref>] [--branch <name>] [--ticket <KEY>] [--repo <path> | --from-worktree <role>] [--no-kickoff] [--resume <session-id>] [--link-node-modules]
        --branch: that exact branch name · --ticket: the key a branch template asks for (teamctl policy branch-template)
        --repo: worktree and branch in ANOTHER git repository; the guard holds the teammate to that worktree
        --from-worktree: a fresh conversation in a stopped worker's built worktree, on a new branch
        --link-node-modules: a brand-new lane shares its repository's node_modules instead of installing 2+ GB
        of its own. One directory for every lane: an install in any lane changes them all.
        A spawn is refused under disk-min-gb free disk (policy disk-guard)
        models: glm53 · flash (Z.ai) · fable · opus · sonnet · haiku (Claude: always the newest of that family, teamctl models) · astra (ChatGPT)
                kimi · moonshot · deepseek · minimax · qwen      other providers, through Claude Code (each needs its own Keychain key)
                claude:<model-id> · codex:<model-id> · kimi:<model-id> · moonshot:<model-id> · deepseek:<model-id>
                minimax:<model-id> · qwen:<model-id>      any model in any team, whoever leads
                moonshot and deepseek bill every token (metered): refused unless the owner's config file says WOLFMUX_METERED=on;
                teamctl status marks them with $
        --from-worktree <role>: a fresh conversation for a NEW role in that stopped worker's worktree,
                on a new branch (the old branch and commits stay). What git ignores (node_modules,
                build output) is kept, so install and build are not repeated — but parking that
                worker sweeps its build output first (policy auto-prune), so run
                teamctl keep <role> BEFORE stopping the lane you mean to hand over; the flag
                comes across with the worktree
    teamctl stop <role>                               close the pane; worktree, branch and record stay — unless the
                                                      lane's work is all in main, then it is reclaimed (see Disk)
    teamctl remove <role>... [--force] [--yes]        take a stopped worker off the books (worktree, branch,
                                                      record); --force discards work that is nowhere else
    teamctl restart <role> [--continue] [--resume <session-id>] [--model <model>]    its own conversation, or the one you name;
                                                      on its recorded model, or the one --model records
                                                      (ids: teamctl status --json | jq -r '.agents[].session_id')
    teamctl nudge <role>|--all [--id <bead-id>] [--quiet]    one fixed notification line in a pane
                                                      (--quiet: nobody to notify is not an error; the Beads hook uses it)
  Messages for you  agents write to you in Beads: bd create "Subject" -t message -a human -d "..."
         The status bar shows 📨 and how many are unread (🔔: a permission request is waiting).
         prefix N, or a click on the number, opens them: Enter reads one, r marks it read.
  Notices  nothing is typed into a pane YOU are using (policy human-pane-typing): one your client
         shows, with focus or a key in the last 2 min. Nor into a Claude lead's pane while you are
         attached. A notice for an agent is filed and its own hooks hand it over: in a pane you
         are using, with its next prompt; a worker's elsewhere at its turn end. A lead you are
         attached to is not told at its turn end (that text would print in full in your pane):
         its waiter wakes it within ~15 s once you are not using its pane (policy lead-wake),
         and the pane shows one line, "wolfmux: team notice".
         This is NOT an agent's Beads inbox — the work itself is always bd list --assignee <role>
    teamctl inbox [<role>] [--all] [--json] [--keep]       (alias: notices)
                                                      for debugging: the PANE notices filed for a
                                                      role (default: the lead), newest last. Not
                                                      your messages, and not counted on the status
                                                      bar. --all: every role of the team.
                                                      --keep: leave them marked new
  Policy and permissions
    teamctl policy [<key> <value>]                    lead-permissions · worker-permissions · browser-writes ask|allow
                                                      (DEFAULT ask; allow writes a Chrome-write ALLOW rule into every agent's
                                                      settings) · worker-spawn ·
                                                      worker-isolation (the worktree guard) · worker-context full|trim|lean
                                                      (what of ~/.claude a worker's conversation starts with; default trim) ·
                                                      lead-teams (may the lead found teams) ·
                                                      disk-guard refuse|warn|off · disk-min-gb <number> · link-node-modules on|off
                                                      auto-prune on|off (sweep a lane's build output as soon as it is parked)
                                                      auto-reclaim on|off (take a parked lane off the books once its work is all in main)
                                                      output-offload on|off (a long Bash output goes to a log; the agent sees its head,
                                                      tail, failure lines and the path; default on)
                                                      branch-template (how this team names workers' branches: {team} {role} {ts} {ticket})
                                                      human-pane-typing off|idle (type a notice into a pane you are watching?
                                                      default off = never; idle = once it is quiet. Yours alone: an agent gets 77)
                                                      lead-wake unwatched|off (may an idle lead wake itself for a notice while
                                                      you are not using its pane? default unwatched. Yours alone: 77)
                                                      orphan-steward <team>|off (for the whole project: whose lead may restart or
                                                      stop a team you founded while its lead is not running. Yours alone: 77)
                                                      lead-model <model>|default (for the whole project: what a NEW lead starts
                                                      on; default opus. Yours alone: 77)
                                                      team-memory <team>|off (for the whole project: the one team whose lead keeps
                                                      a private memory folder; teamctl memory below. Yours alone to turn on: 77)
                                                      restore-on-limit report|<model> (default report: name a model to restart
                                                      a restored lead on it when its transcript reports a usage limit)
    teamctl approvals [--all]                         workers' permission requests (worker-permissions=lead)
  Team memory  one team's lead keeps a private memory folder, ~/.wolfmux/memory/<project>/<team>/ (default: none)
    teamctl memory [status]                           anyone: which team has it, the folder's sizes, the MEMORY.md index against
                                                      its 25,000-byte cap, and whether the running lead was started with it. The
                                                      folder's path and the lead's conversation id: only to you or that lead
    teamctl memory enable <team>                      yours alone (77 for an agent): sets policy team-memory, creates the folder
                                                      (mode 700) from the installed skeleton, runs mem init. An existing folder is kept.
                                                      Refused for a team an agent founded: its lead would never get it
    teamctl memory adopt <team>                       yours alone (77 for an agent): the team's founder becomes you (record and
                                                      meta.json), logged; then enable may give its lead the memory
    teamctl memory disable                            you, or that team's own lead: policy off. Nothing is deleted
    teamctl memory path · teamctl memory check        the folder's path (exit 1 when off) · its own lint (mem check);
                                                      both yours or that team's own lead's (77 for anyone else)
                                                      Every change reaches a running lead only at its next restart. That lead is
                                                      started with "run <folder>/bin/mem boot" every time. While it is on, every
                                                      lead's --continue needs a stored conversation id (they share one folder).
                                                      Workers are refused the folder (worktree guard)
    teamctl approve <id>...|--all      teamctl deny <id> "<reason>"
  Look
    teamctl status [--json]        (alias: workers)   process + worktree state per role, team by team;
                                                      CONTEXT: what each agent's conversation holds (tokens, share of the window)
    teamctl teams [--json]                            the short list: state (running or orphaned), lead, agents, disk and founder per team
    teamctl dashboard [--json] [--once] [--interval <seconds>] [--full] [--socket <path>]
                                                      EVERY team on this machine, across every project, in one read-only view:
                                                      per agent its state, the cpu and memory of its process tree, context use and
                                                      when its transcript was last written; per team its totals, state and cached
                                                      lane disk; the machine's load, memory and free disk at the foot.
                                                      prefix O opens it in a popup (q closes it). --once prints it and exits,
                                                      --interval sets the redraw (default 5 s), --full reads context and the
                                                      transcript time for teams whose session is not live too (slower).
                                                      --socket asks that tmux server instead of the default one (the key binding
                                                      hands its own #{socket_path} over; the socket is never guessed).
                                                      It never runs du: lane totals are what teamctl teams left behind, and the
                                                      view says so when the number is stale.
    teamctl panes                                     what tmux reports per pane
    teamctl capture <role> [-n|--lines <count>] [--all]    recent terminal output
    teamctl log <role>                                full scrollback
    teamctl attach                 (alias: open)      teamctl focus <role>
    teamctl layout [lead-left|lead-top|tiled]         how the panes are arranged (default: lead-left)
  Git
    teamctl worktrees
    teamctl diff <role> [--stat|--names|--commits|--working]
  Disk  (a lane worktree carries 2-3 GB of node_modules and build output; parking one used to keep all of it)
    teamctl prune [--all-teams] [--dry-run] [--keep-node-modules]
                                                      take the build output of every PARKED lane of
                                                      the team: node_modules, .next, dist, .turbo, build,
                                                      coverage and the cache directories. Running lanes and
                                                      anything git tracks are never touched; a lane that holds
                                                      other uncommitted files is skipped and named.
                                                      --dry-run reports and deletes nothing (anyone may run it)
                                                      --keep-node-modules takes the build caches only
                                                      --all-teams every team of every project on this machine,
                                                      with a total per team and one for the machine. Yours alone
                                                      to run, from your own terminal: a lead gets exit 77
    teamctl stop <role>                               parks the lane AND sweeps its build output (policy auto-prune,
                                                      on by default). auto-prune off: the build caches only,
                                                      node_modules kept, which is what stop did before v1.17.0
    teamctl reclaim [--all-teams] [--dry-run]         take every FINISHED parked lane of the team off the books:
                                                      worktree, branch and record. A lane goes only when its task
                                                      is closed in Beads, its branch's content is in main or the
                                                      integration branch (merged, cherry-picked or squashed),
                                                      nothing is uncommitted or stashed, and gh shows no open PR.
                                                      A check that cannot be answered keeps the lane. Parking a
                                                      lane (stop, destroy) does this by itself (policy
                                                      auto-reclaim, on by default), for every parked lane.
                                                      --dry-run says what would go and what holds the rest
                                                      (anyone may run it)
                                                      --all-teams every team of every project on this machine.
                                                      Yours alone to run: a lead gets exit 77
    teamctl keep [<role> [on|off]]                    never sweep or reclaim that lane automatically (an expensive
                                                      checkout: a long install, a seeded database; a worker you
                                                      mean to restart). With no role: what is protected now.
                                                      teamctl prune and teamctl reclaim honour it too
    teamctl remove <role> · destroy --worktrees       take all of it, the worktree goes anyway
    teamctl status                                    free disk, what this team's lanes take, and for every parked
                                                      lane that cannot go: holding <size>: <reason>
    teamctl teams                                     measures the lanes (a du per lane; status and the bar read the number)
    Every sweep and every removed lane is written down in ~/.wolfmux/state/reclaimed.jsonl: when, which team,
    which lane, how much, and for a removed lane the branch and the full sha it was at. Before teamctl deletes
    a branch, by any command, it prints "<role>: branch <name> was at <sha>".
  Heavy runs  (one machine, several teams: a test gate, a measurement, a long build)
    teamctl heavy [--timeout <seconds>] [--quiet] <command>...
                                                      run it holding the machine's heavy lock, so nothing else
                                                      heavy runs beside it and no lane is swept while it does.
                                                      Returns the COMMAND's exit status, and says what it waited
                                                      for. --timeout gives up after that many seconds (exit 75)
                                                      instead of waiting; --quiet says nothing about waiting.
                                                      Use this rather than lockf by hand: bare 'lockf' DELETES
                                                      the lock file when the command ends, and the lock lives on
                                                      the inode, so one holder without -k silently disables the
                                                      lock for every team at once
  Status bar
    teamctl bar [--explain]                           the one line tmux shows in status-right, and with --explain
                                                      a legend naming every field of it (teams run idle load mem
                                                      disk held). A terminal has no hover, so this is the legend
  Tab completion
    teamctl completion <zsh|bash>                     print the tab-completion script of that shell, so
                                                      source <(teamctl completion zsh) works, and in bash
                                                      eval "$(teamctl completion bash)"; install.sh
                                                      wires it into ~/.zshrc (then: teamctl <Tab>)
  Claude Code
    /teamctl, /team-status, /team-prune, /team-destroy, ...   slash commands for the
                                                      commands above, installed by install.sh into
                                                      ~/.claude/commands/ (README: Claude Code slash commands)
  Housekeeping
    teamctl doctor [--probe]                          provider / billing isolation report; --probe also asks each provider whose
                                                      key is set up if its endpoint accepts it (one incomplete request each,
                                                      nothing billed, only the HTTP status is shown). Also: which model each
                                                      running agent started on, and the restart that moves it to a newer one
    teamctl models [--json] [--refresh]               what fable, opus, sonnet and haiku mean today: alias, model id, label and
                                                      where the id came from (config pin, today's probe, built-in id), then
                                                      the model each running agent started on and whether a newer one exists.
                                                      WOLFMUX_MODEL_POLICY=latest (default) asks Claude Code at most once a day
                                                      per alias, when an agent starts; pinned keeps the built-in ids.
                                                      --refresh asks again now (one tiny call per alias, on your subscription)
    teamctl destroy [--worktrees] [--yes]             end the team. A worker whose work is all in main goes with it
                                                      (policy auto-reclaim), every other worktree and branch stays;
                                                      --worktrees also removes workers that hold nothing
    teamctl destroy --purge [--force] [--keep-transcripts] [--memory] [--yes]
                                                      DELETE the team: session, every worktree, the branches teamctl
                                                      created, records, transcripts. Lists uncommitted and unmerged work and asks first;
                                                      --force deletes it anyway. teamctl teams shows what a team takes on disk.
                                                      The lead's memory folder (team memory) stays, unless --memory: then it goes
                                                      too: yours alone (77 for an agent), and you type the team's name (no --yes for that)
    teamctl version | help

  Mail  reaches a Claude Code agent through its CLI's hooks, with the body, at its next tool
        call (a Codex agent still gets the typed notice). Backend: native sqlite (default
        for a new project) or Beads, kept for a team already on it; teamctl store shows which.
    teamctl send <role>|<team>.<role>|--all "<subject>" ["<body>"] [--body-file <file>|-] [--re <bead-id>]
    teamctl mail [<role>] [--peek] [--json]           unread mail + open tasks; marks messages
                                                      read for you, unless --peek
  Tasks
    teamctl task <role> "<title>" [-d "<text>"|--body-file <file>|-] [-p <0-4>] [--after <bead-id>]... [--spawn <model>]
    teamctl claim [<id>]                              the caller's only open task, if none is named
    teamctl done [<id>] "<summary>" [--tests "<cmd: result>"] [--body-file <file>] [--allow-dirty]
    teamctl blocked [<id>] "<why>"                    marks it blocked, tells the lead
    teamctl tasks [<role>|--all] [--status <list>] [--json]      default status: open,in_progress,blocked
    teamctl show <id> [--json]                        one task (body, notes, blockers), or a message with its thread
    teamctl note <id> "<text>"                        a durable note on a task; notifies nobody
    teamctl reopen <id> "<why>"      (lead)           send a closed task back, open, the assignee told
    teamctl close <id> -r "<reason>" [--failed]   (lead)    close or reject any task of this team
  Long output  (ADR-0036)
    teamctl run -- <command> [args...]                runs it; a long output goes to a log and you get its head, tail,
                                                      failure lines and the path (Codex agents; Claude agents get this by hook)
  Shared team notes  team knowledge and where an agent left off (ADR-0033)
    teamctl checkpoint "<text>"|--body-file <file>|-|--show [<role>]    save, or print a role's
                                                      stored checkpoint
    teamctl remember "<fact>" [--key <slug>]          a shared team note, any agent; default key: a slug of the text
    teamctl memories [<query>] [--json]               search the shared team notes
    teamctl forget <key>
  Store
    teamctl store [native|beads [--migrate]]          which backend this project's tasks, mail
                                                      and memory live in; no argument shows it
  Full protocol: ~/.config/wolfmux/TEAM_PROTOCOL.md      Docs: ~/.config/wolfmux/README.md
EOF
}

removed_command() {
  /bin/cat >&2 <<EOF
teamctl: '$1' is not a teamctl command.

  message everyone    teamctl send --all "<subject>" "<body>"
  one task or message teamctl show <id> [--json]       its thread: teamctl show <id>
  a list of tasks      teamctl tasks [<role>|--all] [--status <list>]
  your mail            teamctl mail

See: teamctl help
EOF
  exit 64
}

main() {
  # --team <name> may stand anywhere: `teamctl --team review status`, `teamctl stop qa --team review`
  local rest=() command
  while [ "$#" -gt 0 ]; do
    case "$1" in
      # _complete reads the raw line (the --team parsing below would eat the word
      # being completed and refuse an empty --team value): cmd_complete parses itself.
      _complete)
        rest+=("$@")
        break
        ;;
      --team | -T)
        [ "$#" -ge 2 ] || die_usage "--team needs a name"
        WOLFMUX_TEAM_ARG="$2"
        shift
        ;;
      --team=*) WOLFMUX_TEAM_ARG="${1#--team=}" ;;
      *) rest+=("$1") ;;
    esac
    shift
  done
  if [ "${#rest[@]}" -gt 0 ]; then set -- "${rest[@]}"; fi
  if [ -n "${WOLFMUX_TEAM_ARG:-}" ]; then
    valid_team_name "$WOLFMUX_TEAM_ARG" || die_usage "$(team_name_error "$WOLFMUX_TEAM_ARG")"
  fi
  command="${1:-help}"
  [ "$#" -gt 0 ] && shift
  case "$command" in
    start) cmd_start "$@" ;;
    spawn) cmd_spawn "$@" ;;
    stop) cmd_stop "$@" ;;
    remove) cmd_remove "$@" ;;
    restart) cmd_restart "$@" ;;
    model) cmd_model "$@" ;;
    destroy) cmd_destroy "$@" ;;
    prune) cmd_prune "$@" ;;
    reclaim) cmd_reclaim "$@" ;;
    finish) cmd_finish "$@" ;;
    restore) cmd_restore "$@" ;;
    keep) cmd_keep "$@" ;;
    bar) cmd_bar "$@" ;;
    heavy) cmd_heavy "$@" ;;
    nudge) cmd_nudge "$@" ;;
    inbox | notices) cmd_inbox "$@" ;;
    policy) cmd_policy "$@" ;;
    memory) cmd_memory "$@" ;;
    layout) cmd_layout "$@" ;;
    approvals) cmd_approvals "$@" ;;
    approve) cmd_approve "$@" ;;
    deny) cmd_deny "$@" ;;
    _permission-hook) cmd_permission_hook "$@" ;;
    status | workers) cmd_status "$@" ;;
    teams) cmd_teams "$@" ;;
    dashboard) cmd_dashboard "$@" ;;
    _overview-badge) cmd_overview_badge "$@" ;;
    _prompt) cmd_prompt "$@" ;;
    panes) cmd_panes "$@" ;;
    capture) cmd_capture "$@" ;;
    log) cmd_capture "$@" --all ;;
    focus) cmd_focus "$@" ;;
    attach | open) cmd_attach "$@" ;;
    worktrees) cmd_worktrees "$@" ;;
    diff) cmd_diff "$@" ;;
    doctor) cmd_doctor "$@" ;;
    models) cmd_models "$@" ;;
    _model-badge) cmd_model_badge "$@" ;;
    completion) cmd_completion "$@" ;;
    _complete) cmd_complete "$@" ;;
    _run-agent) cmd_run_agent "$@" ;;
    _refresh-hooks) cmd_refresh_hooks "$@" ;;
    _splash) cmd_splash "$@" ;;
    _notify) cmd_notify "$@" ;;
    _notify-pending) cmd_notify_pending "$@" ;;
    _inbox-badge) cmd_inbox_badge "$@" ;;
    _inbox-stop) cmd_inbox_stop "$@" ;;
    _inbox-prompt) cmd_inbox_prompt "$@" ;;
    _inbox-wake) cmd_inbox_wake "$@" ;;
    _human-inbox) cmd_human_inbox "$@" ;;
    _popup) cmd_popup "$@" ;;
    _human-inbox-hook) cmd_human_inbox_hook "$@" ;;
    _open-team) cmd_open_team "$@" ;;
    _guard) cmd_guard "$@" ;;
    _hook) cmd_hook "$@" ;;
    _deliver) cmd_deliver "$@" ;;
    store) cmd_store "$@" ;;
    send) cmd_send "$@" ;;
    mail) cmd_mail "$@" ;;
    checkpoint) cmd_checkpoint "$@" ;;
    run) cmd_run "$@" ;;
    task) cmd_task "$@" ;;
    done) cmd_done "$@" ;;
    blocked) cmd_blocked "$@" ;;
    claim) cmd_claim "$@" ;;
    tasks) cmd_tasks "$@" ;;
    show) cmd_show "$@" ;;
    note) cmd_note "$@" ;;
    reopen) cmd_reopen "$@" ;;
    close) cmd_close "$@" ;;
    remember) cmd_remember "$@" ;;
    memories) cmd_memories "$@" ;;
    forget) cmd_forget "$@" ;;
    broadcast | message-history) removed_command "$command" ;;
    version | --version | -V) say "teamctl $WOLFMUX_VERSION" ;;
    help | --help | -h) usage ;;
    *)
      usage >&2
      die_usage "unknown command: $command"
      ;;
  esac
}

main "$@"
