#!/bin/bash
# teamctl — tmux processes, models, git worktrees and lifecycle for a local
# multi-model AI development team. Nothing else: tasks and messages live in
# Beads (bd). No daemon, no network service, no API keys.
#
# Code:    ~/.config/wolfmux/lib/*.sh      State: ~/.wolfmux/state/<project>/
# Docs:    ~/.config/wolfmux/README.md     Worktrees: ~/.wolfmux/worktrees/<project>/
set -euo pipefail

WOLFMUX_HOME="${WOLFMUX_HOME:-$HOME/.config/wolfmux}"
TEAMCTL_SELF="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"

for module in provider-env common registry tmuxctl worktree beads policy approvals agents views doctor brand notify layout; do
  if [ ! -r "$WOLFMUX_HOME/lib/$module.sh" ]; then
    echo "teamctl: missing $WOLFMUX_HOME/lib/$module.sh" >&2
    exit 78
  fi
  # shellcheck source=/dev/null
  . "$WOLFMUX_HOME/lib/$module.sh"
done
wolfmux_load_config # ~/.config/wolfmux/config supplies defaults; the environment wins
tm_adopt_legacy_server

usage() {
  /bin/cat <<'EOF'
teamctl — tmux panes, models, worktrees and lifecycle for your AI team

  Lead  (the only manager; start/stop/restart/destroy/policy/approve are reserved for it and for you)
    teamctl start <fable|astra> [--no-attach] [--continue] [--init-beads|--skip-beads]
                  [--lead-permissions skip|ask] [--worker-permissions skip|lead|ask] [--worker-spawn on|off]
  Workers
    teamctl spawn <role> <glm53|flash|fable|astra> [--base <ref>] [--no-kickoff]
    teamctl stop <role>
    teamctl restart <role> [--continue]
    teamctl nudge <role>|--all [--id <bead-id>]     one fixed notification line in a pane
  Policy and permissions
    teamctl policy [<key> <value>]                    lead-permissions · worker-permissions · worker-spawn
    teamctl approvals [--all]                         workers' permission requests (worker-permissions=lead)
    teamctl approve <id>...|--all      teamctl deny <id> "<reason>"
  Look
    teamctl status [--json]        (alias: workers)   process + worktree state per role
    teamctl panes                                     what tmux reports per pane
    teamctl capture <role> [-n <lines>|--all]         recent terminal output
    teamctl log <role>                                full scrollback
    teamctl attach                 (alias: open)      teamctl focus <role>
    teamctl layout [lead-left|lead-top|tiled]         how the panes are arranged (default: lead-left)
  Git
    teamctl worktrees
    teamctl diff <role> [--stat|--names|--commits|--working]
  Housekeeping
    teamctl doctor                                    provider / billing isolation report
    teamctl destroy [--worktrees] [--yes]
    teamctl version | help

  Tasks and messages are Beads, not teamctl:
    bd create "Title" -t task -p 1 -a backend -d "what to do"      assign work
    bd create "Subject" -t message -a frontend -d "body"            message an agent
    bd list --assignee <role> --status open --include-infra        an agent's inbox (tasks + messages)
    bd show <id> · bd update <id> --claim · bd close <id> -r "..."  · bd ready
  Full protocol: ~/.config/wolfmux/TEAM_PROTOCOL.md      Docs: ~/.config/wolfmux/README.md
EOF
}

moved_to_beads() {
  /bin/cat >&2 <<EOF
teamctl: '$1' is not a teamctl command — tasks and messages live in Beads (bd).

  message an agent     bd create "Subject" -t message -a <role> -d "body"      (long body: --body-file <file>)
  your inbox           bd list --assignee \$TEAM_ROLE --status open --include-infra
  read / mark read     bd show <id>   then   bd close <id> -r read
  reply in a thread    bd create "Re: ..." -t message -a <role> -d "..." --deps replies-to:<id>
  message history      bd list --type message --all          thread: bd show <id> --thread
  create a task        bd create "Title" -t task -p 1 -a <role> -d "details" [--deps <blocker-id>]
  claim / block / done bd update <id> --claim · bd update <id> --status blocked · bd close <id> -r "commit <sha>; tests pass"
  what is ready        bd ready            everything in progress: bd list --status in_progress

The recipient's pane is notified automatically (Beads hook -> teamctl nudge).
EOF
  exit 64
}

main() {
  local command="${1:-help}"
  [ "$#" -gt 0 ] && shift
  case "$command" in
    start) cmd_start "$@" ;;
    spawn) cmd_spawn "$@" ;;
    stop) cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    destroy) cmd_destroy "$@" ;;
    nudge) cmd_nudge "$@" ;;
    policy) cmd_policy "$@" ;;
    layout) cmd_layout "$@" ;;
    approvals) cmd_approvals "$@" ;;
    approve) cmd_approve "$@" ;;
    deny) cmd_deny "$@" ;;
    _permission-hook) cmd_permission_hook "$@" ;;
    status | workers) cmd_status "$@" ;;
    panes) cmd_panes "$@" ;;
    capture) cmd_capture "$@" ;;
    log) cmd_capture "$@" --all ;;
    focus) cmd_focus "$@" ;;
    attach | open) cmd_attach "$@" ;;
    worktrees) cmd_worktrees "$@" ;;
    diff) cmd_diff "$@" ;;
    doctor) cmd_doctor "$@" ;;
    _run-agent) cmd_run_agent "$@" ;;
    _refresh-hooks) cmd_refresh_hooks "$@" ;;
    _splash) cmd_splash "$@" ;;
    _notify) cmd_notify "$@" ;;
    send | inbox | broadcast | task | tasks | message-history) moved_to_beads "$command" ;;
    version | --version | -V) say "teamctl $WOLFMUX_VERSION" ;;
    help | --help | -h) usage ;;
    *)
      usage >&2
      die_usage "unknown command: $command"
      ;;
  esac
}

main "$@"
