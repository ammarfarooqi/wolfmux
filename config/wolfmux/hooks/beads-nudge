#!/bin/bash
# beads-nudge — Beads event hook target (on_create / on_update / on_close).
#
# Beads is the data plane: the bead already holds the full task or message.
# This only decides WHO needs to hear about it, then hands the bead to
# `teamctl _deliver` (lib/mail.sh), which keeps its body for that agent's hooks and files
# one notice through `teamctl nudge`'s path (lib/inbox.sh), and keeps the index of the
# human's unread messages (`teamctl _human-inbox-hook`). It never blocks, slows or fails
# a bd command.
#
# argv:  <bead-id> <create|update|close>       stdin: the bead as JSON
event="${2:-}"
payload="$(/bin/cat)"

jq_bin="$(command -v jq 2>/dev/null || true)"
[ -n "$jq_bin" ] || jq_bin="/usr/bin/jq"
teamctl_bin="${WOLFMUX_BIN_DIR:-$HOME/bin}/teamctl"
[ -x "$jq_bin" ] && [ -x "$teamctl_bin" ] || exit 0

# Unit separator, not tab: a whitespace IFS would collapse empty fields (an
# unassigned bead) and shift every later field one place left.
fields="$(printf '%s' "$payload" | "$jq_bin" -r '[.id // "", .assignee // "", .issue_type // "", .status // ""] | join("\u001f")' 2>/dev/null)" || exit 0
IFS=$'\037' read -r bead_id assignee bead_type status <<EOF
$fields
EOF

# The human's unread messages (v1.20.0): every message bead goes to teamctl, which keeps
# the small index the status-bar number is counted from — adds an open message for the
# human, drops one that was closed or handed to somebody else. Here and not filtered on
# the assignee, because only teamctl knows the human's configured name (WOLFMUX_HUMAN)
# and a reassignment AWAY from him has to reach it too. In the background and detached,
# like the nudge below: a bd command never waits for it, and its failure is nobody's.
if [ "$bead_type" = "message" ]; then
  ({ printf '%s' "$payload" | "$teamctl_bin" _human-inbox-hook "$event"; } </dev/null >/dev/null 2>&1 &)
fi

actor="${BEADS_ACTOR:-${TEAM_ROLE:-}}"
# All teams of a project share its Beads; a named team's agents are "<team>.<role>",
# so the lead to tell is the lead of the actor's own team.
case "$actor" in
  *.*) lead="${actor%%.*}.lead" ;;
  *) lead="lead" ;;
esac
target=""

case "$event" in
  create | update)
    # Someone else put, or changed, something on <assignee>'s plate.
    if [ -n "$assignee" ] && [ "$assignee" != "$actor" ] && [ "$status" != "closed" ]; then
      target="$assignee"
    # A worker flagged its task as blocked: the lead should know.
    elif [ "$bead_type" != "message" ] && [ "$status" = "blocked" ] && [ -n "$actor" ] && [ "$actor" != "$lead" ]; then
      target="$lead"
    fi
    ;;
  close)
    # A worker finished a task (closing a message only marks it read).
    if [ "$bead_type" != "message" ] && [ -n "$actor" ] && [ "$actor" != "$lead" ]; then
      target="$lead"
    fi
    ;;
esac

[ -n "$target" ] || exit 0
(printf '%s' "$payload" | "$teamctl_bin" _deliver "$target" --event "$event" >/dev/null 2>&1 &)
exit 0
