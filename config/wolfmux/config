# wolfmux launcher settings — plain KEY=value lines, read by the launchers in ~/bin.
# A pane's environment comes from the tmux server, not from the shell you typed
# `teamctl spawn` in, so persistent knobs live here. An environment variable of
# the same name still wins for a launcher you start by hand.
#
# How GLM workers receive the Z.ai Coding Plan key (always read from the Keychain):
#   helper  the key is handed to Claude Code through apiKeyHelper and never enters
#           the environment, so a worker's subprocesses cannot see or leak it (default)
#   env     Z.ai's documented ANTHROPIC_AUTH_TOKEN variable. A last resort, for an endpoint that
#           refuses helper mode: it cannot fix a wrong key (teamctl doctor --probe checks the key).
#WOLFMUX_GLM_AUTH_MODE=helper

# GLM context window. Default: 200000 tokens, declared to Claude Code so it does not print
# its "isn't described by this version's model catalog" notice in every worker pane.
#   1m        request GLM's 1M-token window (uses plan quota faster)
#   <number>  declare another window, in tokens
#WOLFMUX_GLM_CONTEXT=1m

# --- other providers (claude-kimi, claude-moonshot, claude-deepseek, claude-minimax, claude-qwen) ---
# Moonshot and DeepSeek bill per request with no local cap: their launchers and
# `teamctl spawn` / `start` refuse while this is off. Switching it on is the owner's
# decision, at this file; an agent that asks for it should be refused.
#   on  let the metered providers start
#WOLFMUX_METERED=off

# How each provider's key reaches its workers, the same two modes as GLM above:
#   helper  through apiKeyHelper, never in the environment (default)
#   env     the vendor's documented variable (ANTHROPIC_API_KEY for Kimi, ANTHROPIC_AUTH_TOKEN
#           for the others). A last resort: it cannot fix a wrong key (teamctl doctor --probe checks
#           it), and for ANTHROPIC_API_KEY Claude Code asks 'use this API key?' in the pane, where an
#           unattended worker waits.
#WOLFMUX_KIMI_AUTH_MODE=helper
#WOLFMUX_MOONSHOT_AUTH_MODE=helper
#WOLFMUX_DEEPSEEK_AUTH_MODE=helper
#WOLFMUX_MINIMAX_AUTH_MODE=helper
#WOLFMUX_QWEN_AUTH_MODE=helper

# The context window declared to Claude Code, per provider. Defaults (tokens):
# Kimi 262144, Moonshot 1048576, DeepSeek 786432, MiniMax 1000000, Qwen 262144.
#   <number>  declare another window
#WOLFMUX_KIMI_CONTEXT=262144
#WOLFMUX_MOONSHOT_CONTEXT=1048576
#WOLFMUX_DEEPSEEK_CONTEXT=786432
#WOLFMUX_MINIMAX_CONTEXT=1000000
#WOLFMUX_QWEN_CONTEXT=262144

# Model pins: the ids a provider's launcher uses for the main and the background tier.
# The defaults live in config/wolfmux/lib/providers.sh. Pin when a vendor changes an id
# and you need the new one before the next wolfmux release. GLM's two ids are fixed by
# its plan, so GLM cannot be pinned.
#WOLFMUX_KIMI_MODEL=kimi-for-coding
#WOLFMUX_KIMI_FAST_MODEL=kimi-for-coding
#WOLFMUX_MOONSHOT_MODEL=kimi-k3[1m]
#WOLFMUX_MOONSHOT_FAST_MODEL=kimi-k3[1m]
#WOLFMUX_DEEPSEEK_MODEL=deepseek-v4-pro[1m]
#WOLFMUX_DEEPSEEK_FAST_MODEL=deepseek-v4-flash
#WOLFMUX_MINIMAX_MODEL=MiniMax-M3[1m]
#WOLFMUX_MINIMAX_FAST_MODEL=MiniMax-M3[1m]
#WOLFMUX_QWEN_MODEL=qwen3.7-plus
#WOLFMUX_QWEN_FAST_MODEL=qwen3.7-plus

# --- team policy defaults (per team: `teamctl policy`, or flags on `teamctl start`) ---
# How agents treat permission prompts.
#   skip  the CLI's bypass mode (--dangerously-skip-permissions / Codex equivalent): nothing is asked
#   lead  workers only: every request goes to the lead, who runs `teamctl approve|deny`
#   ask   the normal prompt in the agent's own pane
#WOLFMUX_LEAD_PERMISSIONS=skip
#WOLFMUX_WORKER_PERMISSIONS=skip
# May a worker add teammates with `teamctl spawn`? The lead is told every time one does.
#WOLFMUX_WORKER_SPAWN=off
# Keep every worker inside its own worktree and on its own branch: tool calls that reach
# outside are refused with a reason (a guard against mistakes, not a sandbox).
#WOLFMUX_WORKER_ISOLATION=on
# May a lead found further teams (teamctl start <model> --team <new> --handover <bead>)?
# You are notified every time one does.
#WOLFMUX_LEAD_TEAMS=on
# Seconds a worker waits for the lead's decision before its own prompt appears (lead mode).
#WOLFMUX_APPROVAL_TIMEOUT=600
# How workers' branches are named, for every team that does not set its own
# (`teamctl policy branch-template`). Placeholders: {team} {role} {ts} {ticket}. {ts} is the
# timestamp and is required: it is what keeps two workers of one role on two branches. With
# {ticket} in it, a spawn needs `--ticket <KEY>` (or the team's default: `teamctl start <model>
# --ticket <KEY>`). Unset means the built-in shape, ai/{role}-{ts} and ai/{team}/{role}-{ts}.
# Set this when your repository's hooks require a shape, e.g. a Jira key in every branch name.
#WOLFMUX_BRANCH_TEMPLATE=feature-{ticket}-{role}-{ts}

# How the panes are arranged (per team: `teamctl layout <name>`).
#   lead-left (default)  the lead large on the left, workers stacked on the right
#   lead-top             the lead across the top, workers side by side below
#   tiled                an even grid
#WOLFMUX_LAYOUT=lead-top

# The wolf that greets you when you open a team (teamctl start / attach). Any key closes it.
#WOLFMUX_SPLASH=off

# Desktop notification when an agent finishes a turn. It is sent through the terminal
# attached to the team, so clicking it brings that tab to the front.
#   all (default) · lead = only the manager · off
#WOLFMUX_NOTIFY=lead
# Which terminal a click on a notification opens when the team is on no screen:
# iterm | terminal (default: the one you last attached from, else iTerm2 if installed)
#WOLFMUX_TERMINAL=iterm

# Model pins (what the keys fable, opus, sonnet, haiku and astra mean).
#WOLFMUX_FABLE_MODEL=claude-fable-5-1[1m]
#WOLFMUX_OPUS_MODEL=claude-opus-5
#WOLFMUX_SONNET_MODEL=claude-sonnet-5
#WOLFMUX_HAIKU_MODEL=claude-haiku-4-5-20251001
#WOLFMUX_ASTRA_MODEL=gpt-6-astra
