# wolfmux launcher settings — plain KEY=value lines, read by the launchers in ~/bin.
# A pane's environment comes from the tmux server, not from the shell you typed
# `teamctl spawn` in, so persistent knobs live here. An environment variable of
# the same name still wins for a launcher you start by hand.
#
# How GLM workers receive the Z.ai Coding Plan key (always read from the Keychain):
#   helper  the key is handed to Claude Code through apiKeyHelper and never enters
#           the environment, so a worker's subprocesses cannot see or leak it (default)
#   env     Z.ai's documented ANTHROPIC_AUTH_TOKEN variable. A last resort, for an endpoint that
#           refuses helper mode: it cannot fix a wrong key (teamctl doctor --probe checks the key).
#WOLFMUX_GLM_AUTH_MODE=helper

# GLM context window. Default: 200000 tokens, declared to Claude Code so it does not print
# its "isn't described by this version's model catalog" notice in every worker pane.
#   1m        request GLM's 1M-token window (uses plan quota faster)
#   <number>  declare another window, in tokens
#WOLFMUX_GLM_CONTEXT=1m

# --- other providers (claude-kimi, claude-moonshot, claude-deepseek, claude-minimax, claude-qwen) ---
# Moonshot and DeepSeek bill per request with no local cap: their launchers and
# `teamctl spawn` / `start` refuse while this is off. Switching it on is the owner's
# decision, at this file; an agent that asks for it should be refused.
#   on  let the metered providers start
#WOLFMUX_METERED=off

# How each provider's key reaches its workers, the same two modes as GLM above:
#   helper  through apiKeyHelper, never in the environment (default)
#   env     the vendor's documented variable (ANTHROPIC_API_KEY for Kimi, ANTHROPIC_AUTH_TOKEN
#           for the others). A last resort: it cannot fix a wrong key (teamctl doctor --probe checks
#           it), and for ANTHROPIC_API_KEY Claude Code asks 'use this API key?' in the pane, where an
#           unattended worker waits.
#WOLFMUX_KIMI_AUTH_MODE=helper
#WOLFMUX_MOONSHOT_AUTH_MODE=helper
#WOLFMUX_DEEPSEEK_AUTH_MODE=helper
#WOLFMUX_MINIMAX_AUTH_MODE=helper
#WOLFMUX_QWEN_AUTH_MODE=helper

# The context window declared to Claude Code, per provider. Defaults (tokens):
# Kimi 262144, Moonshot 1048576, DeepSeek 786432, MiniMax 1000000, Qwen 262144.
#   <number>  declare another window
#WOLFMUX_KIMI_CONTEXT=262144
#WOLFMUX_MOONSHOT_CONTEXT=1048576
#WOLFMUX_DEEPSEEK_CONTEXT=786432
#WOLFMUX_MINIMAX_CONTEXT=1000000
#WOLFMUX_QWEN_CONTEXT=262144

# Model pins: the ids a provider's launcher uses for the main and the background tier.
# The defaults live in config/wolfmux/lib/providers.sh. Pin when a vendor changes an id
# and you need the new one before the next wolfmux release. GLM's two ids are fixed by
# its plan, so GLM cannot be pinned.
#WOLFMUX_KIMI_MODEL=kimi-for-coding
#WOLFMUX_KIMI_FAST_MODEL=kimi-for-coding
#WOLFMUX_MOONSHOT_MODEL=kimi-k3[1m]
#WOLFMUX_MOONSHOT_FAST_MODEL=kimi-k3[1m]
#WOLFMUX_DEEPSEEK_MODEL=deepseek-v4-pro[1m]
#WOLFMUX_DEEPSEEK_FAST_MODEL=deepseek-v4-flash
#WOLFMUX_MINIMAX_MODEL=MiniMax-M3[1m]
#WOLFMUX_MINIMAX_FAST_MODEL=MiniMax-M3[1m]
#WOLFMUX_QWEN_MODEL=qwen3.7-plus
#WOLFMUX_QWEN_FAST_MODEL=qwen3.7-plus

# --- team policy defaults (per team: `teamctl policy`, or flags on `teamctl start`) ---
# How agents treat permission prompts.
#   skip  the CLI's bypass mode (--dangerously-skip-permissions / Codex equivalent): nothing is asked
#   lead  workers only: every request goes to the lead, who runs `teamctl approve|deny`
#   ask   the normal prompt in the agent's own pane
#WOLFMUX_LEAD_PERMISSIONS=skip
#WOLFMUX_WORKER_PERMISSIONS=skip
# May a worker add teammates with `teamctl spawn`? The lead is told every time one does.
#WOLFMUX_WORKER_SPAWN=off
# Keep every worker inside its own worktree and on its own branch: tool calls that reach
# outside are refused with a reason (a guard against mistakes, not a sandbox).
#WOLFMUX_WORKER_ISOLATION=on
# May a lead found further teams (teamctl start <model> --team <new> --handover <bead>)?
# You are notified every time one does.
#WOLFMUX_LEAD_TEAMS=on
# The orphan steward: the team whose LEAD may bring back a team YOU founded while that
# team's lead is not running (teamctl restart lead, teamctl stop <role>; nothing else).
# The default of the orphan-steward policy, for every project that does not set its own
# (`teamctl policy orphan-steward <team>|off`, yours alone to change). Default off.
#WOLFMUX_ORPHAN_STEWARD=communication-management
# The model a NEW team's lead starts on when `teamctl start` names none. The default of the
# lead-model policy (`teamctl policy lead-model <model>|default`, yours alone to change).
# Leads run Opus; Fable only when asked for: `teamctl start fable`, or for a running team
# `teamctl model lead fable [--now]`. A team that had a lead keeps that lead's own model.
#WOLFMUX_LEAD_MODEL=opus
# Seconds a worker waits for the lead's decision before its own prompt appears (lead mode).
#WOLFMUX_APPROVAL_TIMEOUT=600
# How workers' branches are named, for every team that does not set its own
# (`teamctl policy branch-template`). Placeholders: {team} {role} {ts} {ticket}. {ts} is the
# timestamp and is required: it is what keeps two workers of one role on two branches. With
# {ticket} in it, a spawn needs `--ticket <KEY>` (or the team's default: `teamctl start <model>
# --ticket <KEY>`). Unset means the built-in shape, ai/{role}-{ts} and ai/{team}/{role}-{ts}.
# Set this when your repository's hooks require a shape, e.g. a Jira key in every branch name.
#WOLFMUX_BRANCH_TEMPLATE=feature-{ticket}-{role}-{ts}

# --- disk (each lane worktree carries its own node_modules and build output) ---
# What `teamctl spawn` does when free disk is under WOLFMUX_DISK_MIN_GB.
#   refuse (default)  no lane is created; the message names the number and `teamctl prune --dry-run`
#   warn              a warning, and the lane is created anyway
#   off               no check at all
#WOLFMUX_DISK_GUARD=warn
# The free space a spawn asks for, in whole gigabytes — counted the way df and Finder do
# NOT count them: 1 GB here is 1024 MB (a gibibyte), the same unit teamctl prints sizes in.
# A lane costs about 3 GB once it has installed and built, so the default leaves room for
# several more. 0 switches the limit off. No leading zero: write 8, not 08.
#WOLFMUX_DISK_MIN_GB=20
# Link a new lane's node_modules to the project root's copy instead of letting the lane
# install 2+ GB of its own (`teamctl spawn --link-node-modules` does it for one lane).
# Off by default: it is ONE directory for every lane and for your own checkout, so an
# `npm install` in any lane changes the dependencies of all of them.
#WOLFMUX_LINK_NODE_MODULES=off
# Sweep a lane's build output (node_modules, .next, dist, .turbo, build, coverage and the
# cache directories) the moment the lane is parked, instead of waiting for someone to
# remember `teamctl prune`. On by default: a parked lane holds 2-3 GB for days, and 50.9 GB
# of the 90.3 GB under ~/.wolfmux/worktrees on this machine was build output (measured
# 2026-10-13). Nothing a person wrote is ever taken, a running lane is never swept, and one
# expensive checkout is protected with `teamctl keep <role>`. Every sweep is logged in
# ~/.wolfmux/state/reclaimed.jsonl.
#WOLFMUX_AUTO_PRUNE=off
# Take a parked lane off the books by itself (its worktree, its branch, its record) once its
# work is finished: its task closed in Beads, its branch's content in main or the integration
# branch, nothing uncommitted or stashed, no open pull request. On by default: the checkout
# itself is the bigger half of a lane (33.3 GB of 52.6 GB here after a full sweep, measured
# 2026-10-13) and only `teamctl remove` gave it back. A check that cannot be answered keeps
# the lane, `teamctl status` says what each kept lane holds and why, and one lane is
# protected with `teamctl keep <role>`. Off: nothing is removed unless you run
# `teamctl reclaim`. A value that is neither on nor off counts as off.
#WOLFMUX_AUTO_RECLAIM=off

# How the panes are arranged (per team: `teamctl layout <name>`).
#   lead-left (default)  the lead large on the left, workers stacked on the right
#   lead-top             the lead across the top, workers side by side below
#   tiled                an even grid
#WOLFMUX_LAYOUT=lead-top

# The wolf that greets you when you open a team (teamctl start / attach). Any key closes it.
#WOLFMUX_SPLASH=off

# Desktop notification when an agent finishes a turn. It is sent through the terminal
# attached to the team, so clicking it brings that tab to the front.
#   all (default) · lead = only the manager · off
#WOLFMUX_NOTIFY=lead
# Which terminal a click on a notification opens when the team is on no screen:
# iterm | terminal (default: the one you last attached from, else iTerm2 if installed)
#WOLFMUX_TERMINAL=iterm

# --- notices: who gets a line typed into their pane, and when ---
# A `[wolfmux] …` notice is always FILED in the role's inbox (the 📨 count, `prefix N`,
# and the agent's own hooks). This says who ALSO gets it typed into their pane, which is
# the only channel that reaches an agent sitting idle.
#   detached-lead (default)  workers, plus the lead's pane while nobody is attached
#   workers                  workers only; the lead's pane is never typed into
#   off                      nobody, ever, not even a Codex pane
#   all                      everybody (but see WOLFMUX_HUMAN_PANE_TYPING just below)
#WOLFMUX_NUDGE_TYPE=workers
# A pane YOU are watching: the lead's pane while you are attached to the team, and any
# pane on your screen. The default of the human-pane-typing policy (teamctl policy shows it).
#   off (default)  never typed into, whatever WOLFMUX_NUDGE_TYPE says. The agent gets the
#                  notice from its own hooks when its turn ends or when you prompt it. The
#                  price: an IDLE lead you are attached to is woken by its own loop or by
#                  you, not by a notice.
#   idle           the v1.16.1 rule: typed in once that pane has been quiet (next setting)
#WOLFMUX_HUMAN_PANE_TYPING=idle
# Under idle only: how quiet the LEAD's pane has to be first, in seconds, with no keystroke
# in it for this long. Default 300. Only the keystroke check uses it; a half-typed line or
# copy mode is busy at any setting.
#WOLFMUX_NUDGE_LEAD_IDLE=300
# 0 brings back the pre-v1.14.0 blind typing: no check for a half-typed line at all.
# For a pane whose TUI draws a placeholder that reads as typing and so never gets notices.
#WOLFMUX_NUDGE_COLLISION_CHECK=0

# A permission request holds a WORKER until the lead answers, so under
# WOLFMUX_HUMAN_PANE_TYPING=idle it is the one notice that can still reach your
# conversation on purpose.
#   grace (default)  typed in after WOLFMUX_INBOX_APPROVAL_GRACE if still pending
#   never            left to the badge
#   always           typed at once
# WOLFMUX_NUDGE_TYPE=off and WOLFMUX_HUMAN_PANE_TYPING=off (the default) outrank all three.
#WOLFMUX_INBOX_APPROVAL_TYPE=never
# Seconds a pending request waits before it is typed in after all (default 20).
#WOLFMUX_INBOX_APPROVAL_GRACE=20
# One desktop notification, at most per role every two minutes, when a notice could not
# reach its agent. off: no banner; the agent still gets the notice from its own hooks, and
# teamctl inbox lists it (WOLFMUX_NOTIFY=off also covers it).
#WOLFMUX_INBOX_STALL_NOTIFY=off

# Your own name in Beads. Agents write to you with bd create ... -t message -a human; the
# 📨 number next to the wolf counts those still unread, and prefix N (or a click on the
# number) opens them. Letters, digits, '.', '_' and '-'; anything else means human.
#WOLFMUX_HUMAN=human

# What the keys fable, opus, sonnet and haiku mean.
#   latest (default)  the newest model of that family Claude Code serves your account. teamctl
#                     asks Claude Code itself (one tiny call with --model <key>, which Claude Code
#                     documents as "an alias for the latest model"), at most once a day per key and
#                     only when an agent starts on it; the answer is cached in ~/.wolfmux/models/.
#                     If that call fails, the built-in id is used and every spawn warns.
#   pinned            the built-in ids of this release (teamctl models shows them); nothing is asked.
# A new model (Opus 5.5 after Opus 5) then reaches NEW agents by itself; running agents keep the
# model they started on until you restart them (teamctl doctor and the status bar say who, and
# the command). teamctl models shows what each key means today and where that came from.
#WOLFMUX_MODEL_POLICY=latest

# Model pins. A pin wins under either policy, and is never probed: the key means exactly that
# id until you delete the line. Leave them commented out to always get the newest model.
#WOLFMUX_FABLE_MODEL=claude-fable-5-1
#WOLFMUX_OPUS_MODEL=claude-opus-5-5
#WOLFMUX_SONNET_MODEL=claude-sonnet-5-5
#WOLFMUX_HAIKU_MODEL=claude-haiku-5-5
#WOLFMUX_ASTRA_MODEL=gpt-6-astra
