# wolfmux launcher settings — plain KEY=value lines, read by the launchers in ~/bin.
# A pane's environment comes from the tmux server, not from the shell you typed
# `teamctl spawn` in, so persistent knobs live here. An environment variable of
# the same name still wins for a launcher you start by hand.
#
# How GLM workers receive the Z.ai Coding Plan key (always read from the Keychain):
#   helper  the key is handed to Claude Code through apiKeyHelper and never enters
#           the environment, so a worker's subprocesses cannot see or leak it (default)
#   env     Z.ai's documented ANTHROPIC_AUTH_TOKEN variable. Use this if workers
#           report an authentication error in helper mode.
#WOLFMUX_GLM_AUTH_MODE=helper

# GLM context window. Default: 200000 tokens, declared to Claude Code so it does not print
# its "isn't described by this version's model catalog" notice in every worker pane.
#   1m        request GLM's 1M-token window (uses plan quota faster)
#   <number>  declare another window, in tokens
#WOLFMUX_GLM_CONTEXT=1m

# --- team policy defaults (per team: `teamctl policy`, or flags on `teamctl start`) ---
# How agents treat permission prompts.
#   skip  the CLI's bypass mode (--dangerously-skip-permissions / Codex equivalent): nothing is asked
#   lead  workers only: every request goes to the lead, who runs `teamctl approve|deny`
#   ask   the normal prompt in the agent's own pane
#WOLFMUX_LEAD_PERMISSIONS=skip
#WOLFMUX_WORKER_PERMISSIONS=skip
# May a worker add teammates with `teamctl spawn`? The lead is told every time one does.
#WOLFMUX_WORKER_SPAWN=off
# Keep every worker inside its own worktree and on its own branch: tool calls that reach
# outside are refused with a reason (a guard against mistakes, not a sandbox).
#WOLFMUX_WORKER_ISOLATION=on
# May a lead found further teams (teamctl start <model> --team <new> --handover <bead>)?
# You are notified every time one does.
#WOLFMUX_LEAD_TEAMS=on
# Seconds a worker waits for the lead's decision before its own prompt appears (lead mode).
#WOLFMUX_APPROVAL_TIMEOUT=600

# How the panes are arranged (per team: `teamctl layout <name>`).
#   lead-left (default)  the lead large on the left, workers stacked on the right
#   lead-top             the lead across the top, workers side by side below
#   tiled                an even grid
#WOLFMUX_LAYOUT=lead-top

# The wolf that greets you when you open a team (teamctl start / attach). Any key closes it.
#WOLFMUX_SPLASH=off

# Desktop notification when an agent finishes a turn. It is sent through the terminal
# attached to the team, so clicking it brings that tab to the front.
#   all (default) · lead = only the manager · off
#WOLFMUX_NOTIFY=lead
# Which terminal a click on a notification opens when the team is on no screen:
# iterm | terminal (default: the one you last attached from, else iTerm2 if installed)
#WOLFMUX_TERMINAL=iterm

# Model pins (what the keys fable, opus, sonnet, haiku and astra mean).
#WOLFMUX_FABLE_MODEL=claude-fable-5-1[1m]
#WOLFMUX_OPUS_MODEL=claude-opus-5
#WOLFMUX_SONNET_MODEL=claude-sonnet-5
#WOLFMUX_HAIKU_MODEL=claude-haiku-4-5-20251001
#WOLFMUX_ASTRA_MODEL=gpt-6-astra
