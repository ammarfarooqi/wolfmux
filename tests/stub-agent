#!/bin/bash
# Stand-in for an agent CLI. Shows how it was wired, makes no model call, then
# echoes whatever gets typed into its pane so notifications can be observed.
flags=""
modelarg=""
codexnotify=false
name=""
previous=""
for arg in "$@"; do
  case "$arg" in
    --dangerously-skip-permissions | --dangerously-bypass-approvals-and-sandbox | --continue) flags="$flags$arg " ;;
  esac
  if [ "$previous" = "--name" ]; then name="$arg"; fi
  if [ "$previous" = "--model" ]; then modelarg="$arg"; fi
  case "$arg" in notify=*_notify*) codexnotify=true ;; esac
  previous="$arg"
done
echo "STUB role=${TEAM_ROLE:-} actor=${BEADS_ACTOR:-} model=${WOLFMUX_MODEL:-} argc=$#"
echo "STUB cwd=$PWD branch=$(git branch --show-current 2>/dev/null)"
echo "STUB leaked=$(env | cut -d= -f1 | grep -E '^(ANTHROPIC_|OPENAI_|CLAUDECODE$|CLAUDE_CODE_CHILD_SESSION$)' | tr '\n' ' ')"
echo "STUB flags=${flags:-none}"
echo "STUB beadsdir=${BEADS_DIR:-none}"
echo "STUB name=${name:-none}"
last=""
for arg in "$@"; do last="$arg"; done
echo "STUB lastarg=$(printf '%s' "$last" | tr '\n' ' ' | cut -c1-200)"
echo "STUB modelarg=${modelarg:-none}"
echo "STUB astra_model=${WOLFMUX_ASTRA_MODEL:-none}"
echo "STUB codexnotify=$codexnotify"
last=""
[ "$#" -eq 0 ] || last="${!#}" # the kickoff prompt, when there is one, is the last argument
case "$last" in *open,in_progress,blocked*"do not start over"*) echo "STUB kickoff_in_progress=yes" ;; *) echo "STUB kickoff_in_progress=no" ;; esac
assignee="none" # whose inbox the kickoff names: in a named team that is <team>.<role>
case "$last" in *"--assignee "*) assignee="${last#*--assignee }" && assignee="${assignee%% *}" ;; esac
echo "STUB kickoff_assignee=$assignee"
if [ -n "${WOLFMUX_EXTRA_SETTINGS:-}" ] && [ -r "$WOLFMUX_EXTRA_SETTINGS" ]; then
  echo "STUB settings=$(jq -c '{teams: .env.CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS, mode: .teammateMode, hook: (.hooks.PermissionRequest != null)}' "$WOLFMUX_EXTRA_SETTINGS")"
  echo "STUB guard=$(jq -c '(.hooks.PreToolUse // []) | map(.hooks[].command) | join(" ") | test("_guard")' "$WOLFMUX_EXTRA_SETTINGS")"
  echo "STUB notify=$(jq -c '{stop: (.hooks.Stop != null), silenced: .env.ECC_DISABLED_HOOKS}' "$WOLFMUX_EXTRA_SETTINGS")"
else
  echo "STUB settings=none"
fi
exec /bin/cat
