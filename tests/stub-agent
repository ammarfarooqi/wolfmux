#!/bin/bash
# Stand-in for an agent CLI. Shows how it was wired, makes no model call, then
# echoes whatever gets typed into its pane so notifications can be observed.
flags=""
name=""
previous=""
for arg in "$@"; do
  case "$arg" in
    --dangerously-skip-permissions | --dangerously-bypass-approvals-and-sandbox | --continue) flags="$flags$arg " ;;
  esac
  if [ "$previous" = "--name" ]; then name="$arg"; fi
  previous="$arg"
done
echo "STUB role=${TEAM_ROLE:-} actor=${BEADS_ACTOR:-} model=${WOLFMUX_MODEL:-} argc=$#"
echo "STUB cwd=$PWD branch=$(git branch --show-current 2>/dev/null)"
echo "STUB leaked=$(env | cut -d= -f1 | grep -E '^(ANTHROPIC_|OPENAI_|CLAUDECODE$|CLAUDE_CODE_CHILD_SESSION$)' | tr '\n' ' ')"
echo "STUB flags=${flags:-none}"
echo "STUB name=${name:-none}"
if [ -n "${WOLFMUX_EXTRA_SETTINGS:-}" ] && [ -r "$WOLFMUX_EXTRA_SETTINGS" ]; then
  echo "STUB settings=$(jq -c '{teams: .env.CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS, mode: .teammateMode, hook: (.hooks.PermissionRequest != null)}' "$WOLFMUX_EXTRA_SETTINGS")"
  echo "STUB notify=$(jq -c '{stop: (.hooks.Stop != null), silenced: .env.ECC_DISABLED_HOOKS}' "$WOLFMUX_EXTRA_SETTINGS")"
else
  echo "STUB settings=none"
fi
exec /bin/cat
