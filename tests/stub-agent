#!/bin/bash
# Stand-in for an agent CLI. Shows how it was wired, makes no model call, then
# echoes whatever gets typed into its pane so notifications can be observed.
flags=""
modelarg=""
codexnotify=false
name=""
newsession=""
resumed=""
previous=""
for arg in "$@"; do
  case "$arg" in
    --dangerously-skip-permissions | --dangerously-bypass-approvals-and-sandbox | --continue) flags="$flags$arg " ;;
  esac
  if [ "$previous" = "--name" ]; then name="$arg"; fi
  if [ "$previous" = "--model" ]; then modelarg="$arg"; fi
  if [ "$previous" = "--session-id" ]; then newsession="$arg"; fi
  if [ "$previous" = "--resume" ]; then resumed="$arg"; fi
  case "$arg" in notify=*_notify*) codexnotify=true ;; esac
  previous="$arg"
done
# What the real CLI refuses, the stand-in refuses too (measured with Claude Code 2.1.289): --resume of an id
# that has no transcript in any folder, and --session-id of an id that already has one. The pane then ends,
# as it does with the real thing, and a check that expected an agent finds none.
has_transcript() {
  local f
  [ -n "${WOLFMUX_CLAUDE_PROJECTS:-}" ] || return 1
  for f in "$WOLFMUX_CLAUDE_PROJECTS"/*/"$1".jsonl; do [ -f "$f" ] && return 0; done
  return 1
}
case "$newsession" in
  "" | [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
  *)
    echo "Error: Invalid session ID. Must be a valid UUID."
    exit 1
    ;;
esac
if [ -n "$resumed" ] && ! has_transcript "$resumed"; then
  echo "No conversation found with session ID: $resumed"
  exit 1
fi
if [ -n "$newsession" ] && has_transcript "$newsession"; then
  echo "Error: Session ID $newsession is already in use."
  exit 1
fi
echo "STUB role=${TEAM_ROLE:-} actor=${BEADS_ACTOR:-} model=${WOLFMUX_MODEL:-} argc=$#"
echo "STUB cwd=$PWD branch=$(git branch --show-current 2>/dev/null)"
echo "STUB leaked=$(env | cut -d= -f1 | grep -E '^(ANTHROPIC_|OPENAI_|CLAUDECODE$|CLAUDE_CODE_CHILD_SESSION$)' | tr '\n' ' ')"
echo "STUB flags=${flags:-none}"
echo "STUB beadsdir=${BEADS_DIR:-none}"
echo "STUB name=${name:-none}"
echo "STUB session_id=${newsession:-none}"
echo "STUB resumed=${resumed:-none}"
last=""
for arg in "$@"; do last="$arg"; done
echo "STUB lastarg=$(printf '%s' "$last" | tr '\n' ' ' | cut -c1-200)"
echo "STUB modelarg=${modelarg:-none}"
echo "STUB astra_model=${WOLFMUX_ASTRA_MODEL:-none}"
echo "STUB codexnotify=$codexnotify"
if [ -n "${WOLFMUX_RUN_DIR:-}" ] && [ -d "$WOLFMUX_RUN_DIR/mail" ]; then echo "STUB rundir=yes"; else echo "STUB rundir=no"; fi
last=""
[ "$#" -eq 0 ] || last="${!#}" # the kickoff prompt, when there is one, is the last argument
case "$last" in *open,in_progress,blocked*"do not start over"*) echo "STUB kickoff_in_progress=yes" ;; *) echo "STUB kickoff_in_progress=no" ;; esac
assignee="none" # whose inbox the kickoff names: in a named team that is <team>.<role>
case "$last" in *"--assignee "*) assignee="${last#*--assignee }" && assignee="${assignee%% *}" ;; esac
echo "STUB kickoff_assignee=$assignee"
hint="no" # the 401 line a provider worker's kickoff carries: which Keychain slot, which endpoint, and the doctor command
slot="none"
endpoint="none"
case "$last" in
  *"doctor --probe"*)
    hint="yes"
    slot="${last#*the key in \'}" && slot="${slot%%\'*}"
    endpoint="${last#*is rejected by }" && endpoint="${endpoint%%;*}"
    ;;
esac
echo "STUB kickoff_probe_hint=$hint"
echo "STUB kickoff_probe_slot=$slot"
echo "STUB kickoff_probe_endpoint=$endpoint"
if [ -n "${WOLFMUX_EXTRA_SETTINGS:-}" ] && [ -r "$WOLFMUX_EXTRA_SETTINGS" ]; then
  echo "STUB settings=$(jq -c '{teams: .env.CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS, mode: .teammateMode, hook: (.hooks.PermissionRequest != null)}' "$WOLFMUX_EXTRA_SETTINGS")"
  echo "STUB guard=$(jq -c '(.hooks.PreToolUse // []) | map(.hooks[].command) | join(" ") | test("_guard")' "$WOLFMUX_EXTRA_SETTINGS")"
  echo "STUB notify=$(jq -c '{stop: (.hooks.Stop != null), silenced: .env.ECC_DISABLED_HOOKS}' "$WOLFMUX_EXTRA_SETTINGS")"
  # the turn hooks (lib/hooks.sh): which events call `teamctl _hook <Event>`
  echo "STUB hooks=$(jq -r '[.hooks // {} | to_entries[] | select(.key as $k | any(.value[].hooks[]; .command | endswith("_hook " + $k))) | .key] | sort | join(",")' "$WOLFMUX_EXTRA_SETTINGS")"
else
  echo "STUB settings=none"
fi
exec /bin/cat
